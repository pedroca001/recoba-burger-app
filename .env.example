# Chave publica da conta Pagar.me/Stone. Pode ser exposta ao navegador.
STONE_PUBLIC_KEY=

# Chave secreta Pagar.me/Stone. Somente backend da Netlify.
STONE_SECRET_KEY=

# Token aleatorio incluido na URL cadastrada para o webhook.
STONE_WEBHOOK_TOKEN=

# Opcional. Mantem o endpoint oficial por padrao.
STONE_API_URL=https://api.pagar.me/core/v5

# Opcional para geocodificacao com maior escala e precisao.
GOOGLE_MAPS_API_KEY=

# Somente desenvolvimento local. Nunca habilitar em producao.
VITE_ENABLE_DEMO_CHECKOUT=false

# Pixel opcional para campanhas Meta Ads.
VITE_META_PIXEL_ID=
